# Server
PORT=3001
HOST=127.0.0.1
NODE_ENV=production
LOG_LEVEL=info

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=7d

# Database — matches the 'messenger' DB on shared Postgres (prompt-factory-v2 uses 'promptfactory')
DATABASE_URL=postgresql://messenger:CHANGE_ME@127.0.0.1:5432/messenger?schema=public

# Web Push (VAPID) — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@future-pulse.de
